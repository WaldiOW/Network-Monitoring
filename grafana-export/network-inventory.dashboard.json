{
  "uid": "network-inventory",
  "title": "Netzwerk-Inventar",
  "tags": ["network", "scanner"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "device_type",
        "label": "Gerätetyp",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(network_device_info, device_type)",
        "query": { "query": "label_values(network_device_info, device_type)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0
      },
      {
        "name": "vendor",
        "label": "Hersteller",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(network_device_info, vendor)",
        "query": { "query": "label_values(network_device_info, vendor)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Geräte gesamt",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "count(network_device_up)", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Online",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum(network_device_up)", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Letzter Scan",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsLocal" } },
      "targets": [
        { "refId": "A", "expr": "max(network_scan_last_timestamp_seconds) * 1000", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Geräteliste",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "network_device_info{device_type=~\"$device_type\", vendor=~\"$vendor\"} * on(ip) group_left() network_device_up",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Offline", "color": "red", "index": 1 },
                "1": { "text": "Online", "color": "green", "index": 0 }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
          "renameByName": {
            "Value": "Status",
            "ip": "IP-Adresse",
            "name": "Name",
            "mac": "MAC",
            "vendor": "Hersteller",
            "device_type": "Gerätetyp"
          },
          "indexByName": { "name": 0, "ip": 1, "mac": 2, "device_type": 3, "vendor": 4, "Value": 5 }
        } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "IP-Adresse", "desc": false }] } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ]
}
